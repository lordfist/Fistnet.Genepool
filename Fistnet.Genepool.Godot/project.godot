; Genepool GPU viewer. Edit scenes with Godot .NET; C# builds in the root VS2022 solution.
config_version=5

[application]
config/name="Genepool"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/min_width=1024
window/size/min_height=640

[dotnet]
project/assembly_name="Fistnet.Genepool.Godot"
project/solution_directory=".."

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
